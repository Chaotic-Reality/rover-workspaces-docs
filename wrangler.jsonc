{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rover-public-assets-preview",
  "compatibility_date": "2026-10-01",
  // Local assets preview only. Deploy with npm run deploy:beta, which uses
  // the private security handler and its canonical deployment configuration.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "site",
  },
}
